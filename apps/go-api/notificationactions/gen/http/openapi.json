              },
              {
                "type": "null"
              }
            ]
          },
          "entity_name": {
            "type": "string",
            "maxLength": 255
          },
          "id": {
            "type": "string",
            "readOnly": true,
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "is_inbox_issue": {
            "type": "boolean",
            "readOnly": true
          },
          "is_intake_issue": {
            "type": "boolean",
            "readOnly": true
          },
          "is_mentioned_notification": {
            "type": "boolean",
            "readOnly": true
          },
          "message": {},
          "message_html": {
            "type": "string"
          },
          "message_stripped": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "project": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "read_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "receiver": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "sender": {
            "type": "string",
            "maxLength": 255
          },
          "snoozed_till": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": {
            "type": "string"
          },
          "triggered_by": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              },
              {
                "type": "null"
              }
            ]
          },
