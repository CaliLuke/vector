FROM oven/bun:1.4.4-alpine

RUN apk add --no-cache libc6-compat
WORKDIR /app

COPY . .
RUN --mount=type=cache,id=bun-cache,target=/root/.bun/install/cache NODE_ENV=development bun install --frozen-lockfile
EXPOSE 3003

ENV TURBO_TELEMETRY_DISABLED=1

VOLUME [ "/app/node_modules", "/app/live/node_modules"]

CMD ["bun", "run", "--filter", "live", "dev"]
