FROM oven/bun:1.4.4-alpine

RUN apk add --no-cache libc6-compat

# Set working directory
WORKDIR /app

COPY . .

RUN --mount=type=cache,id=bun-cache,target=/root/.bun/install/cache NODE_ENV=development bun install --frozen-lockfile

EXPOSE 3002

ENV VITE_SPACE_BASE_PATH="/spaces"

VOLUME [ "/app/node_modules", "/app/apps/space/node_modules"]

CMD ["bun", "run", "--filter", "space", "dev"]
