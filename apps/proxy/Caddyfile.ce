(plane_proxy) {
	request_body {
		max_size {$FILE_SIZE_LIMIT}
	}

	redir /spaces /spaces/ permanent
	reverse_proxy /spaces/* space:3000

	redir /god-mode /god-mode/ permanent
	reverse_proxy /god-mode/* admin:3000

	reverse_proxy /live/* live:3000

	@sticky_detail_without_slash {
		method GET DELETE
		path_regexp ^/api/workspaces/[^/]+/stickies/[^/]+$
	}
	rewrite @sticky_detail_without_slash {path}/

	import /etc/caddy/go-active-routes.caddy

	reverse_proxy /api/* {$GO_API_UPSTREAM:go-api:8080}

	reverse_proxy /auth/* {$GO_API_UPSTREAM:go-api:8080}

	respond /static/* 404

	reverse_proxy /{$BUCKET_NAME}/* plane-rustfs:9000
	reverse_proxy /{$BUCKET_NAME} plane-rustfs:9000

	reverse_proxy /* web:3000
}

{
	{$CERT_EMAIL}
	acme_ca {$CERT_ACME_CA:https://acme-v02.api.letsencrypt.org/directory}
	{$CERT_ACME_DNS}
	servers {
		max_header_size 25MB
		client_ip_headers X-Forwarded-For X-Real-IP
		trusted_proxies static {$TRUSTED_PROXIES:0.0.0.0/0}
	}
}

{$SITE_ADDRESS} {
	import plane_proxy
}
