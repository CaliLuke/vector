      "protocol_methods": ["HEAD", "OPTIONS"],
      "request_body": false,
      "source_branches": [
        {
          "when": "project guest with active project membership, type=custom-work-items",
          "observable": "Guest access is allowed and returns populated work-item groups."
        },
        {
          "when": "project member, type=custom-work-items",
          "observable": "Returns populated work-item groups filtered by project and grouping dimensions."
        },
        {
          "when": "anonymous",
          "observable": "Returns 401."
        },
        {
          "when": "project member, type=work-items",
          "observable": "Returns one bucket per month from project creation through the current month. Counts and completed state groups are bucketed by issue created date, independently of completed_at."
        },
        {
          "when": "project member, type=work-items with cycle_id or module_id",
          "observable": "Emits one daily bucket over the selected cycle/module start and end dates; created counts use cycle/module link creation dates and completed counts use the linked issue state. Missing start or end bounds return an empty data list and empty schema."
        },
        {
          "when": "project member, type=work-items with recognized date_filter",
          "observable": "Filters issue creation dates to the selected relative window and emits month-start buckets from the later of project creation and the window start through the current month."
        },
        {
          "when": "cycle_id or module_id belongs to a different project",
          "observable": "Intentional security correction: return empty data/schema; never disclose the foreign project date bounds. Pristine Django leaks date keys."
        },
        {
          "when": "project member, type=custom-work-items or work-items with a triage issue",
          "observable": "Custom and monthly chart projections exclude triage issues through Issue.issue_objects."
        }
      ],
