  "contract": [
    {
      "dimension": "decoding",
      "expected": "Decode percent escapes and plus once; preserve malformed escapes as literal data; semicolons belong to keys/values and ampersand separates fields."
    },
    {
      "dimension": "selection",
      "expected": "All 44 declared root/activity scalar names and the 28 existing filter aliases select the last decoded occurrence, including blank and valueless occurrences. Unknown repeated fields retain all values in encounter order."
    },
    {
      "dimension": "presence",
      "expected": "Skip empty ampersand components; preserve actual empty keys and blank values; omitted names remain omitted."
    },
    {
      "dimension": "unicode",
      "expected": "Percent-encoded invalid UTF-8 uses Python replacement spans, including two replacements for FF FF and one for truncated E2 82."
    },
    {
      "dimension": "schema",
      "expected": "Resolve OpenAPI parameter/schema references before checking scalar coverage; future array/scalar name collisions fail the guard and require an operation-specific policy."
    },
    {
      "dimension": "evidence",
      "expected": "Clone request URLs, preserve RequestURI and captured original query, and remain idempotent. Original field count and pagination syntax stay available to existing compatibility checks."
    },
    {
      "dimension": "protocol",
      "expected": "Keep the normalizer inside the Go transport boundary and after outer compatibility captures. Preserve existing authentication, permission, negotiation, redirect, GET/HEAD, CORS and audit behavior; add no new error response policy."
    },
    {
      "dimension": "field_limit",
      "expected": "Django counts original ampersand components, including empty and trailing components, before decoding. Accept 1000 and reject 1001. All existing format/limit consumers use the first original-query snapshot, not normalized URL.RawQuery. Preserve their current error/auth/negotiation/session precedence."
    },
    {
      "dimension": "public_metadata_logging",
      "expected": "Generated production mount preserves original repeated, encoded and malformed query bytes in API activity QueryParams and the Django-position request log URL, even though generated handlers receive normalized scalar values."
    }
  ],
